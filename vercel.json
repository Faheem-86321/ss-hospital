{
  "version": 2,
  "builds": [
    { "src": "**/*.php", "use": "vercel-php@0.7.3" },
    { "src": "assets/**", "use": "@vercel/static" },
    { "src": "images/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "^/$", "dest": "/web_temp/login.html.php" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
